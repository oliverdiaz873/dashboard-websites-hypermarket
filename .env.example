# Dashboard — Hipermercado Superior
#
# NOTA: esta app Angular NO lee variables de entorno en tiempo de build.
# Estas variables documentan la configuración de API requerida para el
# despliegue; el valor debe aplicarse a `src/environments/environment.production.ts`
# (`apiBaseUrl`) ANTES del build de producción, o inyectarse por el CI/CD del hosting.

# URL base del backend (Express + MongoDB).
# Desarrollo: http://localhost:3000/api
# Producción: REEMPLAZAR por la URL real del API desplegado. No debe quedar vacío
# ni apuntar a localhost en un despliegue de producción.
DASHBOARD_API_BASE_URL=http://localhost:3000/api